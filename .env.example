# ---------------------------------------------------------------------------
# LegalEase configuration
# Copy this file to `.env` and fill in the values. `.env` is git-ignored and
# must never be committed.
# ---------------------------------------------------------------------------

# --- Google Gemini (backend only - never exposed to the frontend) ----------
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model used for document generation. Change it here to switch models.
GEMINI_MODEL=gemini-3.8-flash
# Reasoning depth for Gemini 3.x models: low | medium | high
GEMINI_THINKING_LEVEL=medium
# Upper bound on generated tokens (thinking + document text).
GEMINI_MAX_OUTPUT_TOKENS=16384
# Per-request timeout (seconds) and automatic retries for transient errors.
GEMINI_TIMEOUT_SECONDS=90
GEMINI_MAX_RETRIES=2
# Tried in order when the main model is overloaded or rate-limited.
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash

# --- Frontend -> backend ----------------------------------------------------
# Where the Streamlit frontend reaches the FastAPI backend.
BACKEND_URL=http://localhost:8000
# How long the frontend waits for the backend (seconds).
BACKEND_TIMEOUT_SECONDS=300

# --- Backend server ---------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API (CORS).
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Paper size for DOCX/PDF exports: A4 | LETTER
DOCUMENT_PAGE_SIZE=A4
